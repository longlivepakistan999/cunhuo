[Unit]
Description=Cunhuo - Asset Survival Detection Web UI
After=network-online.target
Wants=network-online.target
# 重启限速必须在 [Unit] 段,放 [Service] 会被 systemd 忽略
StartLimitBurst=10
StartLimitIntervalSec=60

[Service]
Type=simple
# 改成你实际的目录和用户
WorkingDirectory=/opt/cunhuo
ExecStart=/opt/cunhuo/start.sh
User=root
Group=root

# Basic Auth 账号密码 (两个都设才会启用,任一为空则不鉴权)
# 改成你自己的强密码
Environment=CUNHUO_USER=admin
Environment=CUNHUO_PASS=change-this-password

# 崩了自动拉起
Restart=on-failure
RestartSec=3

# 优雅停止：留 30s 给当前任务把 CSV flush
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
